# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB Atlas connection string for cloud database persistence.
# When omitted, the server automatically persists all data to ./data/aviator-db.json.
MONGODB_URI=""

# SESSION_SECRET: Secret key used to sign session tokens on the server.
SESSION_SECRET="change_this_to_a_long_random_secret_string_in_production"

# ADMIN_USERNAME: Initial administrator username created on server startup if no admin exists.
ADMIN_USERNAME="admin"

# ADMIN_PASSWORD: Initial administrator password created on server startup if no admin exists.
ADMIN_PASSWORD="AdminDemoPassword123!"

# DEFAULT_WELCOME_BONUS: Initial welcome bonus in virtual demo coins for new accounts.
DEFAULT_WELCOME_BONUS="500"

